# =============================================
# StudyQuest – AWS Lightsail production env
# Copy to `deploy/lightsail/.env` on the instance and fill in real values.
# Placeholders only — never commit the filled-in `.env`.
# =============================================

# --- Caddy / TLS ---
# sslip.io resolves to the instance's own public IP, so Caddy can issue a
# Let's Encrypt cert without owning a real domain. Dashes, not dots, in the IP.
API_DOMAIN=api-203-0-113-10.sslip.io

# --- PostgreSQL (local container, not published to the host) ---
POSTGRES_USER=studyquest
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURA
POSTGRES_DB=studyquest
# POSTGRES_HOST is forced to "postgres" by docker-compose.prod.yml; do not set it here.
# DATABASE_URL is only used instead of POSTGRES_* when pointing at a managed DB
# (Aiven/Neon/Supabase) instead of the local postgres container. Leave unset for Lightsail.
# DATABASE_URL=

# Schema is managed by TypeORM migrations in prod, not synchronize.
TYPEORM_SYNC=false
TYPEORM_LOGGING=false

NODE_ENV=production
PORT=3000

# Days after which QuestRetentionService deletes a quest and its source file.
QUEST_RETENTION_DAYS=30

# --- Subscription plan limits ---
QUEST_DAILY_LIMIT=20
PLAN_FREE_QUESTS_PER_DAY=20
PLAN_PRO_QUESTS_PER_DAY=100
PLAN_FREE_UPLOAD_MB=10
PLAN_PRO_UPLOAD_MB=25
PLAN_FREE_PARTY_SIZE_MAX=6
PLAN_PRO_PARTY_SIZE_MAX=10

# --- Payments (Mercado Pago Checkout Pro) ---
# Missing MP_ACCESS_TOKEN / MP_WEBHOOK_SECRET / PUBLIC_API_URL / FRONTEND_URL /
# PRO_PRICE_ARS_FALLBACK → the app still boots and checkout answers 503
# "Pagos no disponibles".
# Production access token (APP_USR-...) of the MP app, from Your integrations >
# app > Production credentials. The money goes to the account that owns it.
MP_ACCESS_TOKEN=CAMBIAR_MP_ACCESS_TOKEN
# Webhooks secret (Your integrations > app > Webhooks > Secret signature).
MP_WEBHOOK_SECRET=CAMBIAR_MP_WEBHOOK_SECRET
MP_SANDBOX=false
PRO_USD_PRICE=5
# Required. ARS price when dolarapi.com is unreachable, and the reference of the
# sanity band: a quote below 0.5x or above 5x this is discarded (fallback used).
PRO_PRICE_ARS_FALLBACK=7500
# Hard minimum ARS price (default: half the fallback).
# PRO_PRICE_ARS_FLOOR=
PUBLIC_API_URL=https://api-54-156-9-166.sslip.io
FRONTEND_URL=https://lorengrz.github.io/StudyQuest

# --- Auth ---
JWT_SECRET=CAMBIAR_SECRET_MUY_LARGA_Y_ALEATORIA
# Comma-separated. Only the GitHub Pages frontend origin in prod.
CORS_ALLOWED_ORIGINS=https://lorengrz.github.io

# --- AI provider ---
# AWS cutover target. NOTE: as of this deploy, backend/src/modules/ai only
# registers gemini/openai/anthropic/groq/mock providers — a "bedrock"
# QuizAiProvider still needs to be added before AI_PROVIDER=bedrock works.
# Ship these vars ahead of time so the app.module.ts pipeline is switched here first.
AI_PROVIDER=bedrock
BEDROCK_MODEL=us.amazon.nova-2-lite-v1:0
BEDROCK_MODEL_PRO=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_FALLBACK_MODELS=us.amazon.nova-lite-v1:0
# Study bot (Pro) model. Defaults to the main model if unset.
STUDY_BOT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- AWS ---
# Least privilege: this key is used both by the app and by backup.sh's cron
# job, so scope it to s3:PutObject on backups/* only (no GetObject/ListBucket)
# plus whatever the app itself needs on the rest of the bucket/table. Restoring
# a backup requires a *different*, broader-access profile — see
# deploy/lightsail/README.md "Restore from a backup".
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CAMBIAR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CAMBIAR_AWS_SECRET_ACCESS_KEY
S3_BUCKET=studyquest-files-493735739644
DYNAMO_QUIZZES_TABLE=studyquest-quizzes

# --- MarkItDown sidecar ---
# MARKITDOWN_URL is forced to http://markitdown:8000 by docker-compose.prod.yml.
# MARKITDOWN_TIMEOUT_MS=30000

# --- Legacy AI providers (only needed if AI_PROVIDER is switched back off bedrock) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-latest
# GEMINI_MODEL_PRO=gemini-flash-latest
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
