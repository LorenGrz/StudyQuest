# =============================================
# StudyQuest – Variables de entorno (raíz)
# Copia este archivo como .env y completá los valores
# =============================================

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=studyquest
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURA
POSTGRES_DB=studyquest
TYPEORM_SYNC=true
# En prod se usa DATABASE_URL (connection string completa) en vez de POSTGRES_*.

# Días tras los cuales QuestRetentionService borra un quest y su documento fuente
# en S3 (default 30).
QUEST_RETENTION_DAYS=30

# --- Almacenamiento de archivos (S3) ---
# Bucket donde se guardan los uploads de usuario (quests/, chat/, avatars/).
S3_BUCKET=studyquest-files-493735739644
# Región del bucket (default us-east-1 si no se define).
AWS_REGION=us-east-1
# Solo para desarrollo local con un S3 compatible (ej. MinIO). Sin esto se usa
# el S3 real de AWS.
# S3_ENDPOINT=http://localhost:9000

# --- Planes de suscripción (tiers manuales, sin pasarela de pago) ---
# Límites por plan. QUEST_DAILY_LIMIT sigue funcionando como fallback del free.
QUEST_DAILY_LIMIT=20
PLAN_FREE_QUESTS_PER_DAY=20
PLAN_PRO_QUESTS_PER_DAY=100
PLAN_FREE_UPLOAD_MB=10
PLAN_PRO_UPLOAD_MB=25
PLAN_FREE_PARTY_SIZE_MAX=6
PLAN_PRO_PARTY_SIZE_MAX=10

# --- Autenticación ---
JWT_SECRET=CAMBIAR_SECRET_MUY_LARGA_Y_ALEATORIA
# Orígenes permitidos para CORS (coma-separado). Sin esto → solo localhost dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5199

# --- AI Providers ---
AI_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=TU_API_KEY_DE_GOOGLE_GEMINI
GEMINI_MODEL=gemini-flash-lite-latest
# Modelos de respaldo si el principal tira 503 (coma-separado).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-latest
# Modelo que usa el plan Pro (aiModelTier = full).
GEMINI_MODEL_PRO=gemini-flash-latest
# Modelo del bot de estudio (Pro). Si no está seteado, usa GEMINI_MODEL.
STUDY_BOT_MODEL=gemini-flash-lite-latest

# OpenAI
OPENAI_API_KEY=TU_API_KEY_DE_OPENAI
OPENAI_MODEL=gpt-4.1-mini

# Anthropic
ANTHROPIC_API_KEY=TU_API_KEY_DE_ANTHROPIC
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Groq
GROQ_API_KEY=TU_API_KEY_DE_GROQ
GROQ_MODEL=llama-3.3-70b-versatile
