# =============================================
# StudyQuest – Variables de entorno (raíz)
# Copia este archivo como .env y completá los valores
# =============================================

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=studyquest
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURA
POSTGRES_DB=studyquest
TYPEORM_SYNC=true
# En prod se usa DATABASE_URL (connection string completa) en vez de POSTGRES_*.

# Días tras los cuales QuestRetentionService borra un quest y su documento fuente
# en S3 (default 30).
QUEST_RETENTION_DAYS=30

# --- Almacenamiento de archivos (S3) ---
# Bucket donde se guardan los uploads de usuario (quests/, chat/, avatars/).
S3_BUCKET=studyquest-files-493735739644
# Región del bucket (default us-east-1 si no se define).
AWS_REGION=us-east-1
# Solo para desarrollo local con un S3 compatible (ej. MinIO). Sin esto se usa
# el S3 real de AWS.
# S3_ENDPOINT=http://localhost:9000

# --- Contenido de quizzes (DynamoDB) ---
# Preguntas/opciones viven en DynamoDB (un documento por quest, PK questId).
# Postgres guarda sólo la metadata del quest y los resultados.
DYNAMO_QUIZZES_TABLE=studyquest-quizzes
AWS_REGION=us-east-1
# Credenciales AWS (en prod: usuario IAM con Get/Put/Update/Delete/BatchGet/BatchWrite sobre la tabla).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Local: dynamodb-local de docker-compose. Crear la tabla con `pnpm run dynamo:create-table`.
# DYNAMO_ENDPOINT=http://localhost:8000

# --- Planes de suscripción (código promo, admin o Mercado Pago) ---
# Límites por plan. QUEST_DAILY_LIMIT sigue funcionando como fallback del free.
QUEST_DAILY_LIMIT=20
PLAN_FREE_QUESTS_PER_DAY=20
PLAN_PRO_QUESTS_PER_DAY=100
PLAN_FREE_UPLOAD_MB=10
PLAN_PRO_UPLOAD_MB=25
PLAN_FREE_PARTY_SIZE_MAX=6
PLAN_PRO_PARTY_SIZE_MAX=10

# --- Pagos (Mercado Pago Checkout Pro) ---
# Sin MP_ACCESS_TOKEN / MP_WEBHOOK_SECRET / PUBLIC_API_URL / FRONTEND_URL /
# PRO_PRICE_ARS_FALLBACK la app arranca igual y el checkout responde 503
# "Pagos no disponibles".
# Access token de la aplicación (Tus integraciones > app > Credenciales).
# Para probar: credenciales de prueba (TEST-...) + MP_SANDBOX=true.
MP_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones > app > Webhooks > Clave secreta).
MP_WEBHOOK_SECRET=
MP_SANDBOX=true
# Precio de Pro (30 días) en USD; se cobra en ARS al dólar oficial venta (dolarapi.com).
PRO_USD_PRICE=5
# Precio en ARS si no se puede obtener la cotización (obligatorio). También es la
# referencia del control de cordura: una cotización que dé menos de 0.5× o más
# de 5× este valor se descarta y se cobra el fallback.
PRO_PRICE_ARS_FALLBACK=7500
# Precio mínimo absoluto en ARS (default: la mitad del fallback).
# PRO_PRICE_ARS_FLOOR=
# URL pública del backend (Mercado Pago le manda los webhooks acá; en local usar un túnel).
PUBLIC_API_URL=http://localhost:3000
# URL del frontend incluyendo el base path (vuelta desde Mercado Pago: /plan?pago=...).
FRONTEND_URL=http://localhost:5173/StudyQuest

# --- Autenticación ---
JWT_SECRET=CAMBIAR_SECRET_MUY_LARGA_Y_ALEATORIA
# Orígenes permitidos para CORS (coma-separado). Sin esto → solo localhost dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5199

# --- AI Providers ---
AI_PROVIDER=bedrock
# Override explícito del modelo Pro para cualquier proveedor. Si no está
# seteado, se usa BEDROCK_MODEL_PRO o GEMINI_MODEL_PRO según AI_PROVIDER.
# AI_MODEL_PRO=

# AWS Bedrock (proveedor por defecto)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=TU_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=TU_AWS_SECRET_ACCESS_KEY
BEDROCK_MODEL=us.amazon.nova-2-lite-v1:0
# Modelos de respaldo si el principal tira throttling/503 (coma-separado).
BEDROCK_FALLBACK_MODELS=us.amazon.nova-lite-v1:0
# Modelo que usa el plan Pro (aiModelTier = full).
BEDROCK_MODEL_PRO=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Modelo del bot de estudio (Pro). Si no está seteado, usa BEDROCK_MODEL_PRO.
STUDY_BOT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Materias de la comunidad (R2). Clasificador de nombres: Nova Lite vía Bedrock,
# fail-closed (timeout o salida inválida → se rechaza). Con AI_PROVIDER=mock no
# llama a ningún modelo y acepta lo que pase las capas locales.
# SUBJECT_CLASSIFIER_MODEL=us.amazon.nova-lite-v1:0
# SUBJECT_CLASSIFIER_TIMEOUT_MS=6000
# COMMUNITY_SUBJECTS_PER_DAY=10
# COMMUNITY_SUBJECT_PROMOTE_USERS=3
# COMMUNITY_SUBJECT_HIDE_REPORTS=3

# Gemini (opcional / legacy — solo si AI_PROVIDER=gemini)
GEMINI_API_KEY=TU_API_KEY_DE_GOOGLE_GEMINI
GEMINI_MODEL=gemini-flash-lite-latest
# Modelos de respaldo si el principal tira 503 (coma-separado).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-latest
# Modelo que usa el plan Pro (aiModelTier = full) cuando AI_PROVIDER=gemini.
GEMINI_MODEL_PRO=gemini-flash-latest

# OpenAI
OPENAI_API_KEY=TU_API_KEY_DE_OPENAI
OPENAI_MODEL=gpt-4.1-mini

# Anthropic
ANTHROPIC_API_KEY=TU_API_KEY_DE_ANTHROPIC
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Groq
GROQ_API_KEY=TU_API_KEY_DE_GROQ
GROQ_MODEL=llama-3.3-70b-versatile
