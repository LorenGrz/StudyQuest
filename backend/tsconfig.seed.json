{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": [
    "src/database/seeds/**/*.ts",
    "src/database/scripts/**/*.ts",
    "src/database/migrations/**/*.ts",
    "src/config/**/*.ts",
    "src/modules/**/*.ts",
    "src/common/**/*.ts",
    "src/polyfill.ts"
  ]
}
